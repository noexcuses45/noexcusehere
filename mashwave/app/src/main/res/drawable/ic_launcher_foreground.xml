<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- A bold "U" for Ultimate that cradles a play button: everything the app plays, in one place.
         Drawn inside the 66dp circle that every launcher shape keeps visible. -->
    <path
        android:pathData="M36.5,33 L36.5,55.5 A17.5,17.5 0 0 0 71.5,55.5 L71.5,33"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="10.5" />
    <!-- the play button: a rounded triangle in ice blue, the one cool note against the warm background -->
    <path
        android:pathData="M49.2,40.2 L49.2,58.6 L64.2,49.4 Z"
        android:strokeLineJoin="round"
        android:strokeWidth="4.4">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="64"
                android:endY="58"
                android:startX="49"
                android:startY="40"
                android:type="linear">
                <item android:color="#FFE6FBFF" android:offset="0" />
                <item android:color="#FF5EE6FA" android:offset="1" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="64"
                android:endY="58"
                android:startX="49"
                android:startY="40"
                android:type="linear">
                <item android:color="#FFE6FBFF" android:offset="0" />
                <item android:color="#FF5EE6FA" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
